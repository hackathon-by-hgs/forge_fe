{
  "name": "@forge/types",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.gen.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "types:gen": "openapi-typescript ${FORGE_OPENAPI_URL:-https://forgebe-production.up.railway.app/v1/openapi.json} -o src/api.gen.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forge/eslint-config": "workspace:*",
    "@forge/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.5"
  }
}
