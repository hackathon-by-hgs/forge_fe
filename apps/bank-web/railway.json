{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install -g pnpm@9 && pnpm install --frozen-lockfile && pnpm --filter bank-web... build"
  },
  "deploy": {
    "startCommand": "npx -y pnpm@9 --filter bank-web start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
