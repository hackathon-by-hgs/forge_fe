# Forge backend API base URL.
# Production:  https://forgebe-production.up.railway.app
# Local BE:    http://localhost:3000
# Set in Railway service env for deployed employer-web; copy to .env.local for dev.
NEXT_PUBLIC_API_BASE_URL=https://forgebe-production.up.railway.app

# Optional: Google Maps JavaScript API + Directions API for live job maps (overview, workers, job site).
# Without it, maps fall back to the SVG placeholder. Restrict the key by HTTP referrer in Google Cloud.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
