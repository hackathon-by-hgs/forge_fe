**/node_modules
**/.next
**/dist
**/build
**/coverage
**/.turbo
**/*.tsbuildinfo

# git / editor
.git
.github
.vscode
.idea
**/.DS_Store

# env files — secrets must not bake into images; pass at runtime
**/.env
**/.env.local
**/.env.*.local

# logs & test artifacts
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# docs / config not needed inside the image
**/README.md
**/*.md
docker-compose.yml
ecosystem.config.mjs
nixpacks.toml
.prettierignore
.npmrc

# Don't ignore .npmrc — pnpm respects it during install
!.npmrc
!**/.npmrc
